{
  "name": "tetris-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier . --write",
    "test:ci": "ng test --watch=false --progress=false",
    "audit": "node scripts/audit-ci.mjs",
    "ci": "npm run lint && npm run test:ci && npm run build && npm run audit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": "^20.20.1 || ^22.12.0 || ^24.0.0",
    "npm": ">=9"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "@hono/node-server": "1.19.11",
    "express-rate-limit": "8.3.1",
    "flatted": "3.4.1",
    "hono": "4.12.8",
    "immutable": "5.1.5",
    "undici": "7.24.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.4"
    },
    "@tufjs/models": {
      "minimatch": "10.2.4"
    },
    "glob": {
      "minimatch": "10.2.4"
    },
    "ignore-walk": {
      "minimatch": "10.2.4"
    }
  },
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.4",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.4",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
